{
  "name": "hydroponic-planters",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n broker,backend,web -c magenta,green,cyan \"pnpm dev:broker\" \"pnpm dev:backend\" \"pnpm dev:web\"",
    "dev:broker": "pnpm --filter @planter/backend broker",
    "dev:backend": "pnpm --filter @planter/backend dev",
    "dev:web": "pnpm --filter @planter/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "provision": "pnpm --filter @planter/backend provision"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}

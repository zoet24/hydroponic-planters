# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
#
# Keep the hotspot SSID and password stable between now and the talk: changing
# either means reflashing the board.

wifi_ssid: "Your phone hotspot"
wifi_password: "hotspot-password"

# Fallback access point, used when the hotspot is unreachable.
ap_password: "CHANGE-ME-before-flashing"

# Where the board looks for the broker: this laptop. Prefer the laptop's mDNS
# name over a bare IP. The hotspot hands out a new address on most reconnects,
# and a stale address here surfaces only as `select() timeout` in the device log,
# with nothing pointing at the real cause.
#
# `.local` is verified working on the ESP32-C3 — ESPHome resolves it itself.
# Get the name with `scutil --get LocalHostName` and append `.local`.
# A literal IP still works if mDNS is ever blocked: `ipconfig getifaddr en0`.
mqtt_host: "Your-MacBook.local"

ota_password: "choose-something"
